    <mesh name="finger" file="gripper_meshes/finger.stl"/>

    <!-- Menagerie visual meshes (menagerie/ = franka_emika_panda assets) -->
    <mesh name="m_link0_0" file="menagerie/link0_0.obj"/>
    <mesh name="m_link0_1" file="menagerie/link0_1.obj"/>
    <mesh name="m_link0_2" file="menagerie/link0_2.obj"/>
