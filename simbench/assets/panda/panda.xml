<!-- Self-contained Franka Panda + parallel gripper for simbench.

     Derived from robosuite's panda robot.xml + panda_gripper.xml (MIT
     license).  Changes vs. robosuite:
       - torque actuators replaced by position actuators with joint-space
         damping (general: force = kp*(ctrl-q) - kv*qvel), so the whole
         stack is a plain position-servo robot driven directly by mujoco;
       - the gripper is merged in (right_gripper under right_hand);
       - visual geoms use the MuJoCo Menagerie franka_emika_panda OBJ
         meshes (Apache-2.0) for a realistic multi-material look -- the
         menagerie link frames are kinematically identical to this
         chain, so they drop in untouched; collision geoms stay the
         coarse robosuite link*.stl (validated physics, unchanged);
       - meshdir points at this directory; scenes include this file.

     Robot placement: base sits directly ON the table top (z=0.8);
     link0 bottom face is at base-frame z=0 so it rests flush on the
     table.  Lowering the base 0.112 m vs the old robosuite mount
     (z=0.912) shifts the whole arm workspace down -- task chains
     that bake in absolute world heights must be re-tuned.
-->
<mujoco model="panda">
  <!-- NOTE: no <compiler> here -- the including scene must set
       meshdir="../assets/panda" so the mesh paths below resolve. -->
  <asset>
    <!-- Menagerie panda materials -->
    <material name="panda_white" specular="0.5" shininess="0.25" rgba="1 1 1 1"/>
    <material name="panda_off_white" specular="0.5" shininess="0.25"
              rgba="0.901961 0.921569 0.929412 1"/>
    <material name="panda_black" specular="0.5" shininess="0.25" rgba="0.25 0.25 0.25 1"/>
    <material name="panda_green" specular="0.5" shininess="0.25" rgba="0 1 0 1"/>
    <material name="panda_light_blue" specular="0.5" shininess="0.25"
              rgba="0.039216 0.541176 0.780392 1"/>

    <!-- collision meshes (robosuite, physics-validated) -->
    <mesh name="link0" file="meshes/link0.stl"/>
    <mesh name="link1" file="meshes/link1.stl"/>
    <mesh name="link2" file="meshes/link2.stl"/>
    <mesh name="link3" file="meshes/link3.stl"/>
    <mesh name="link4" file="meshes/link4.stl"/>
    <mesh name="link5" file="meshes/link5.stl"/>
