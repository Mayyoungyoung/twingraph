                    <geom mesh="m_link6_7" material="panda_light_blue" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v7"/>
                    <geom mesh="m_link6_8" material="panda_light_blue" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v8"/>
                    <geom mesh="m_link6_9" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v9"/>
                    <geom mesh="m_link6_10" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v10"/>
                    <geom mesh="m_link6_11" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v11"/>
                    <geom mesh="m_link6_12" material="panda_green" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v12"/>
                    <geom mesh="m_link6_13" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v13"/>
                    <geom mesh="m_link6_14" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v14"/>
                    <geom mesh="m_link6_15" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v15"/>
                    <geom mesh="m_link6_16" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v16"/>
                    <geom type="mesh" group="3" mesh="link6" name="link6_collision"/>
                    <body name="link7" pos="0.088 0 0" quat="0.707107 0.707107 0 0">
                      <inertial pos="0 0 0.08" mass="0.5" diaginertia="0.05 0.05 0.05"/>
                      <joint name="joint7" pos="0 0 0" axis="0 0 1" limited="true"
                             range="-2.8973 2.8973" damping="0.01"/>
                      <geom mesh="m_link7_0" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link7_v0"/>
                      <geom mesh="m_link7_1" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link7_v1"/>
                      <geom mesh="m_link7_2" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link7_v2"/>
                      <geom mesh="m_link7_3" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link7_v3"/>
                      <geom mesh="m_link7_4" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link7_v4"/>
                      <geom mesh="m_link7_5" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link7_v5"/>
                      <geom mesh="m_link7_6" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link7_v6"/>
                      <geom mesh="m_link7_7" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link7_v7"/>
                      <geom type="mesh" group="3" mesh="link7" name="link7_collision"/>
                      <body name="right_hand" pos="0 0 0.1065" quat="0.924 0 0 -0.383">
                        <inertial pos="0 0 0" mass="0.5" diaginertia="0.05 0.05 0.05"/>
                        <!-- Menagerie hand visuals: this frame matches the
                             menagerie hand frame (0.5mm z offset corrected) -->
                        <geom pos="0 0 0.0005" mesh="m_hand_0" material="panda_off_white" type="mesh"
                              contype="0" conaffinity="0" group="1" name="hand_v0"/>
                        <geom pos="0 0 0.0005" mesh="m_hand_1" material="panda_black" type="mesh"
                              contype="0" conaffinity="0" group="1" name="hand_v1"/>
                        <geom pos="0 0 0.0005" mesh="m_hand_2" material="panda_black" type="mesh"
                              contype="0" conaffinity="0" group="1" name="hand_v2"/>
                        <geom pos="0 0 0.0005" mesh="m_hand_3" material="panda_white" type="mesh"
                              contype="0" conaffinity="0" group="1" name="hand_v3"/>
                        <geom pos="0 0 0.0005" mesh="m_hand_4" material="panda_off_white" type="mesh"
                              contype="0" conaffinity="0" group="1" name="hand_v4"/>
                        <body name="right_gripper" pos="0 0 0" quat="0.707107 0 0 -0.707107">
                          <site name="ft_frame" pos="0 0 0" size="0.01 0.01 0.01"
                                rgba="1 0 0 0" type="sphere" group="1"/>
                          <inertial pos="0 0 0.17" quat="0.707107 0.707107 0 0"
                                    mass="0.3" diaginertia="0.09 0.07 0.05"/>
                          <!-- hand collision mesh collides with NOTHING
                               (0/0): the robosuite palm has a finger-rail
                               slot down the middle, but MuJoCo convex-
                               hulls mesh collisions, closing the slot.  A
                               held ring threading down the shaft upper
                               rides inside that slot; with a solid hull
                               the contact wedges the shaft sideways and
                               levers it out of the housing hole
                               (measured: shoved 10mm, one step +3.1mm).
                               robosuite's OSC torque controller pushed
                               through; the bounded position servo here
                               honestly stalls.  The pads carry all
                               functional contact. -->
                          <geom pos="0 0 0" quat="0.707107 0 0 0.707107" type="mesh"
                                contype="0" conaffinity="0"
                                mesh="hand" group="3" name="hand_collision"/>
                          <body name="eef" pos="0 0 0.097" quat="1 0 0 0">
                            <site name="grip_site" pos="0 0 0" size="0.01 0.01 0.01"
                                  rgba="1 0 0 0" type="sphere" group="1"/>
                          </body>
                          <body name="leftfinger" pos="0 0 0.0524" quat="0.707107 0 0 0.707107">
                            <inertial pos="0 0 0.05" mass="0.1" diaginertia="0.01 0.01 0.005"/>
                            <joint name="finger_joint1" pos="0 0 0" axis="0 1 0" type="slide"
                                   limited="true" range="0.0 0.04" damping="100"
                                   armature="1.0" frictionloss="1.0"/>
                            <geom type="mesh" contype="0" conaffinity="0" group="1"
                                  mesh="m_finger_0" material="panda_off_white" name="finger1_v0"/>
                            <geom type="mesh" contype="0" conaffinity="0" group="1"
                                  mesh="m_finger_1" material="panda_black" name="finger1_v1"/>
                            <!-- finger collision meshes collide with NOTHING
                                 (0/0): they extend 4.8mm below and are wider
                                 than the pads, so on low descents they hit
                                 assembly structure first (measured: shaft
                                 collar r13mm vs gear outer r10mm, -1.9mm
                                 penetration blocking the gear seat).  The
                                 pads (1/1) carry all functional contact.
                                 robosuite's OSC torque controller pushed
                                 through these contacts; the bounded
                                 position servo here honestly stalls. -->
                            <geom type="mesh" group="3" conaffinity="0" contype="0"
                                  solref="0.02 1" friction="1 0.005 0.0001" condim="4"
                                  mesh="finger" name="finger1_collision"/>
                            <body name="finger_joint1_tip" pos="0 0.0085 0.056">
                              <inertial pos="0 0 0" mass="0.01" diaginertia="0.01 0.01 0.01"/>
