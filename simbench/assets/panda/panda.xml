  </asset>

  <actuator>
    <!-- position servos with damping; torque limits as in robosuite -->
    <general name="act_j1" joint="joint1" ctrllimited="true" ctrlrange="-2.8973 2.8973"
             forcelimited="true" forcerange="-80 80" gaintype="fixed" gainprm="4000"
             biastype="affine" biasprm="0 -4000 -80"/>
    <general name="act_j2" joint="joint2" ctrllimited="true" ctrlrange="-1.7628 1.7628"
             forcelimited="true" forcerange="-80 80" gaintype="fixed" gainprm="4000"
             biastype="affine" biasprm="0 -4000 -80"/>
    <general name="act_j3" joint="joint3" ctrllimited="true" ctrlrange="-2.8973 2.8973"
             forcelimited="true" forcerange="-80 80" gaintype="fixed" gainprm="3000"
             biastype="affine" biasprm="0 -3000 -60"/>
    <general name="act_j4" joint="joint4" ctrllimited="true" ctrlrange="-3.0718 -0.0698"
             forcelimited="true" forcerange="-80 80" gaintype="fixed" gainprm="3000"
             biastype="affine" biasprm="0 -3000 -60"/>
    <general name="act_j5" joint="joint5" ctrllimited="true" ctrlrange="-2.8973 2.8973"
             forcelimited="true" forcerange="-12 12" gaintype="fixed" gainprm="1500"
             biastype="affine" biasprm="0 -1500 -30"/>
    <general name="act_j6" joint="joint6" ctrllimited="true" ctrlrange="-0.0175 3.7525"
             forcelimited="true" forcerange="-12 12" gaintype="fixed" gainprm="700"
             biastype="affine" biasprm="0 -700 -15"/>
    <general name="act_j7" joint="joint7" ctrllimited="true" ctrlrange="-2.8973 2.8973"
             forcelimited="true" forcerange="-12 12" gaintype="fixed" gainprm="450"
             biastype="affine" biasprm="0 -450 -10"/>
    <!-- gripper fingers: direct position servo (kp/forcerange as robosuite) -->
    <position name="act_finger1" joint="finger_joint1" ctrllimited="true"
              ctrlrange="0.0 0.04" kp="1000" forcelimited="true" forcerange="-20 20"/>
    <position name="act_finger2" joint="finger_joint2" ctrllimited="true"
              ctrlrange="-0.04 0.0" kp="1000" forcelimited="true" forcerange="-20 20"/>
  </actuator>

  <sensor>
    <force name="force_ee" site="ft_frame"/>
    <torque name="torque_ee" site="ft_frame"/>
  </sensor>

  <worldbody>
    <body name="panda_base" pos="-0.56 0 0.8">
      <body name="link0" pos="0 0 0">
        <inertial pos="0 0 0.05" mass="4" diaginertia="0.4 0.4 0.4"/>
        <geom mesh="m_link0_0" material="panda_off_white" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v0"/>
        <geom mesh="m_link0_1" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v1"/>
        <geom mesh="m_link0_2" material="panda_off_white" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v2"/>
        <geom mesh="m_link0_3" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v3"/>
        <geom mesh="m_link0_4" material="panda_off_white" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v4"/>
        <geom mesh="m_link0_5" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v5"/>
        <geom mesh="m_link0_7" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v7"/>
        <geom mesh="m_link0_8" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v8"/>
        <geom mesh="m_link0_9" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v9"/>
        <geom mesh="m_link0_10" material="panda_off_white" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v10"/>
        <geom mesh="m_link0_11" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link0_v11"/>
        <!-- collision geoms live in group 3 (hidden by default): with
             them in group 0 they rendered ON TOP of the visual meshes
             (mujoco draws every enabled group), which made the arm look
             speckled gray.  Group is visualization-only -- physics
             (contype/conaffinity) is unchanged. -->
        <geom type="mesh" group="3" mesh="link0" name="link0_collision"/>
        <body name="link1" pos="0 0 0.333">
          <inertial pos="0 0 -0.07" mass="3" diaginertia="0.3 0.3 0.3"/>
          <joint name="joint1" pos="0 0 0" axis="0 0 1" limited="true"
                 range="-2.8973 2.8973" damping="0.1"/>
          <geom mesh="m_link1" material="panda_white" type="mesh" contype="0" conaffinity="0"
                group="1" name="link1_visual"/>
          <geom type="mesh" group="3" mesh="link1" name="link1_collision"/>
          <body name="link2" pos="0 0 0" quat="0.707107 -0.707107 0 0">
            <inertial pos="0 -0.1 0" mass="3" diaginertia="0.3 0.3 0.3"/>
            <joint name="joint2" pos="0 0 0" axis="0 0 1" limited="true"
                   range="-1.7628 1.7628" damping="0.1"/>
            <geom mesh="m_link2" material="panda_white" type="mesh" contype="0" conaffinity="0"
                  group="1" name="link2_visual"/>
            <geom type="mesh" group="3" mesh="link2" name="link2_collision"/>
            <body name="link3" pos="0 -0.316 0" quat="0.707107 0.707107 0 0">
              <inertial pos="0.04 0 -0.05" mass="2" diaginertia="0.2 0.2 0.2"/>
              <joint name="joint3" pos="0 0 0" axis="0 0 1" limited="true"
                     range="-2.8973 2.8973" damping="0.1"/>
              <geom mesh="m_link3_0" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link3_v0"/>
              <geom mesh="m_link3_1" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link3_v1"/>
              <geom mesh="m_link3_2" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link3_v2"/>
              <geom mesh="m_link3_3" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link3_v3"/>
              <geom type="mesh" group="3" mesh="link3" name="link3_collision"/>
              <body name="link4" pos="0.0825 0 0" quat="0.707107 0.707107 0 0">
                <inertial pos="-0.04 0.05 0" mass="2" diaginertia="0.2 0.2 0.2"/>
                <joint name="joint4" pos="0 0 0" axis="0 0 1" limited="true"
                       range="-3.0718 -0.0698" damping="0.1"/>
                <geom mesh="m_link4_0" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link4_v0"/>
                <geom mesh="m_link4_1" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link4_v1"/>
                <geom mesh="m_link4_2" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link4_v2"/>
                <geom mesh="m_link4_3" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link4_v3"/>
                <geom type="mesh" group="3" mesh="link4" name="link4_collision"/>
                <body name="link5" pos="-0.0825 0.384 0" quat="0.707107 -0.707107 0 0">
                  <inertial pos="0 0 -0.15" mass="2" diaginertia="0.2 0.2 0.2"/>
                  <joint name="joint5" pos="0 0 0" axis="0 0 1" limited="true"
                         range="-2.8973 2.8973" damping="0.1"/>
                  <geom mesh="m_link5_0" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link5_v0"/>
                  <geom mesh="m_link5_1" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link5_v1"/>
                  <geom mesh="m_link5_2" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link5_v2"/>
                  <geom type="mesh" group="3" mesh="link5" name="link5_collision"/>
                  <body name="link6" pos="0 0 0" quat="0.707107 0.707107 0 0">
                    <inertial pos="0.06 0 0" mass="1.5" diaginertia="0.1 0.1 0.1"/>
                    <joint name="joint6" pos="0 0 0" axis="0 0 1" limited="true"
                           range="-0.0175 3.7525" damping="0.01"/>
                    <geom mesh="m_link6_0" material="panda_off_white" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v0"/>
                    <geom mesh="m_link6_1" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v1"/>
                    <geom mesh="m_link6_2" material="panda_black" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v2"/>
                    <geom mesh="m_link6_3" material="panda_white" type="mesh" contype="0" conaffinity="0" group="1" name="link6_v3"/>
