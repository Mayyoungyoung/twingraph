      "perception.detect_part",
      "faults.FailureModel(可选)"
    ],
    "category_cn": "执行类",
    "wrapped": true
  },
  {
    "name": "grasp",
    "category": "exec",
    "description": "抓取：检测/估计（或消费 plan_grasp_pose 工件）→ 接近→ 下降 → 闭爪 → 举升校验的闭环抓取。前置零件存在，后置以举升量判定抓稳。是操作链的核心执行技能。",
    "inputs": {
      "part": "零件名",
      "grasp_pose": "可选预估计抓取位姿工件",
      "press": "压入量 (m)",
      "lift": "举升高度 (m)",
      "tol": "下降容差 (m)",
      "squeeze": "力反馈深咬 (N)",
      "approach_yaw": "接近前腕部偏航"
    },
    "outputs": {
      "ok": "举升校验通过",
      "held_dist": "EEF-零件距离 (m)"
    },
    "preconditions": [
      "<function part_exists at 0x7f3f1b9b11b0>"
    ],
    "postconditions": [
      "零件被抬升 >= VERIFY_LIFT（以 ok 判定）"
