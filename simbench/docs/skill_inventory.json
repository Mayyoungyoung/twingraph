      "perception.estimate_grasp_pose",
      "motion.move_eef"
    ],
    "category_cn": "过渡类",
    "wrapped": true
  },
  {
    "name": "detect",
    "category": "exec",
    "description": "零件检测：在失败模型下感知零件位姿（位置+偏航），可注入高斯噪声/漏检/误检，输出观测供 plan_grasp_pose 消费。是执行链的感知入口。",
    "inputs": {
      "part": "零件名（body）",
      "faults": "可选 FailureModel（漏检/误检/噪声源）",
      "step": "可选步序号（供故障模型归因）",
      "retries": "漏检重试次数（默认 0）"
