    "outputs": {
      "found": "是否检测到",
      "pos": "world xyz 观测",
      "yaw": "偏航观测 (rad)",
      "outcome": "ok|miss|false"
    },
    "preconditions": [
      "<function part_exists at 0x7f3f1b9b11b0>"
    ],
    "postconditions": [
      "检测到则 outcome!=miss 且 pos 非空"
    ],
    "failure_policy": "retry",
    "impl": "规则脚本",
