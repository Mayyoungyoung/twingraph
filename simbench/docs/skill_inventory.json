    "outputs": {
      "xy_err": "xy 误差 (m)",
      "z_err": "z 误差 (m)",
      "tilt": "倾斜角 (deg)",
      "ok": "判定结论"
    },
    "preconditions": [
      "<function part_exists at 0x7f3f1b9b11b0>"
    ],
    "postconditions": [
      "metrics 含 xy_err/tilt 且 ok 反映容差判定"
