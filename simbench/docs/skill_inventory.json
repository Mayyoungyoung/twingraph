[
  {
    "name": "approach",
    "category": "trans",
    "description": "抓取前接近：先到抓取点上方悬停，再垂直下降至抓取高度（不闭合）。与 grasp(approach_direct=True) 组合即标准两段式抓取接近，避免 grasp 内部 safe_z 二次抬升的下降-上升-抽搐。",
    "inputs": {
