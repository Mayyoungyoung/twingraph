# Keep released evidence checksums stable on Windows and Linux.
/docs/evidence/value/*.json text eol=lf
/docs/evidence/value/*.md text eol=lf
/docs/evidence/value/*.txt text eol=lf
/docs/evidence/value/*.svg text eol=lf
/datasets/value/*.json text eol=lf
/datasets/value/*.md text eol=lf
/models/value/*.md text eol=lf
# Immutable v4 evidence and checkpoint sidecars retain their published bytes.
/docs/evidence/value_v4/** -text
/models/value/v4/** -text
# Immutable v5 protocol, evidence, checkpoint sidecars and archive manifests.
/experiments/value_v5/** -text
/docs/evidence/value_v5/** -text
/models/value/v5/** -text
/datasets/value/v5/** -text
